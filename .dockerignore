# Never ship the build context's dependencies or build output; the image
# installs and builds its own inside the builder stage.
node_modules/
packages/*/node_modules/
packages/*/dist/
.parcel-cache/

# Git
.git
.gitignore

# Docker / CI
Dockerfile
.dockerignore
docker-compose*.yml
.github/

# Config is mounted as a volume at runtime
config/

# Documentation and notes (package README/LICENSE files are kept: the
# patterns above are anchored, so packages/*/README.md still ships)
/README.md
/DOCKER.md
/CLAUDE.md

# Editor / OS
.idea/
.vscode/
*.iml
*.swp
.DS_Store
Thumbs.db
